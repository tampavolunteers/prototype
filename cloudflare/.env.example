# Copy to cloudflare/.env (./setup-tunnel.sh does this and fills in the
# generated values). cloudflare/.env is gitignored.

# --- Cloudflare Tunnel (written by ./setup-tunnel.sh) ---
CLOUDFLARE_TUNNEL_ID=
TUNNEL_NAME=tampavolunteers-dev
SITE_HOSTNAME=tampavolunteers.org
API_HOSTNAME=api.tampavolunteers.org
# Pin a cloudflared release if you want reproducible restarts, e.g. 2026.10.0
CLOUDFLARED_VERSION=latest

# --- Database (POSTGRES_PASSWORD generated by ./setup-tunnel.sh) ---
POSTGRES_DB=tampavolunteers
POSTGRES_USER=tampavolunteers
POSTGRES_PASSWORD=

# --- Backend secrets (JWT_SECRET generated by ./setup-tunnel.sh) ---
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Loopback-only ports for local smoke tests / DB tools ---
# Chosen so they don't collide with the root docker-compose.yml dev stack.
FRONTEND_PORT=8081
POSTGRES_PORT=5434
