apiVersion: v1
kind: Secret
metadata:
  name: tampavolunteers-secrets
  namespace: tampavolunteers
  labels:
    app.kubernetes.io/name: tampavolunteers
    app.kubernetes.io/part-of: tampavolunteers-platform
type: Opaque
stringData:
  # Database password - CHANGE IN PRODUCTION
  POSTGRES_PASSWORD: "CHANGE_ME"

  # JWT Secret - MUST be at least 256 bits (32 characters) for HS256
  # Generate with: openssl rand -base64 48
  JWT_SECRET: "CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_48"

  # Spring datasource password (same as POSTGRES_PASSWORD)
  SPRING_DATASOURCE_PASSWORD: "CHANGE_ME"

  # Google OAuth2 credentials
  # Setup: https://console.cloud.google.com/apis/credentials
  # See README.md for detailed instructions
  GOOGLE_CLIENT_ID: "CHANGE_ME"
  GOOGLE_CLIENT_SECRET: "CHANGE_ME"

  # GitHub OAuth2 credentials
  # Setup: https://github.com/settings/developers
  # See README.md for detailed instructions
  GITHUB_CLIENT_ID: "CHANGE_ME"
  GITHUB_CLIENT_SECRET: "CHANGE_ME"
