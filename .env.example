# Database Configuration
POSTGRES_DB=tampavolunteers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Backend Database Connection
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT Secret (minimum 256 bits / 32 characters)
JWT_SECRET=change-me-minimum-32-characters

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth2
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Application Ports (customize to avoid conflicts with other local apps)
BACKEND_PORT=8080
FRONTEND_PORT=5173
PGADMIN_PORT=5050

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@tampavolunteers.local
PGADMIN_DEFAULT_PASSWORD=change-me

# Email Configuration (Optional)
MAIL_HOST=smtp.example.com
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
