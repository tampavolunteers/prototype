# Production Dockerfile for Frontend
# Multi-stage build: Node for building, Nginx for serving

# Stage 1: Build the application
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (including devDependencies for build)
# Use npm install with retry logic for reliability in constrained environments
RUN npm cache clean --force && \
    npm install --prefer-offline --no-audit --progress=false

# Copy source code
COPY . .

# Build arguments for environment variables
ARG VITE_API_BASE_URL=/api
ARG VITE_APP_NAME="Tampa Volunteers"

# Set environment variables for build
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_APP_NAME=$VITE_APP_NAME

# Build the application
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# OpenShift runs containers as non-root by default
# Fix permissions for OpenShift
RUN chmod -R g+rwx /usr/share/nginx/html && \
    chmod -R g+rwx /var/cache/nginx && \
    chmod -R g+rwx /var/log/nginx && \
    chmod -R g+rwx /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chmod g+rwx /var/run/nginx.pid

# Expose port 8080 (non-privileged port for OpenShift)
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
